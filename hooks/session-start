#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

bootstrap_file="${PLUGIN_ROOT}/skills/bootstrap/SKILL.md"

if [ ! -f "$bootstrap_file" ]; then
    echo '[react-pipeline] WARNING: bootstrap SKILL.md not found' >&2
    exit 0
fi

bootstrap_content=$(cat "$bootstrap_file")

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$bootstrap_content")

session_context="<EXTREMELY_IMPORTANT>${escaped}</EXTREMELY_IMPORTANT>"

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"
else
    printf '{"additionalContext":"%s"}\n' "$session_context"
fi

exit 0
